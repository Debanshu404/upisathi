# ==========================================
# Backend Production Environment Variables
# Copy these into your Render.com / Hosting Environment Settings
# ==========================================

PORT=4000
# IMPORTANT for DB_URL:
# 1. Replace <db_username> with your MongoDB Atlas database user (e.g. debanshu)
# 2. Replace <db_password> with your password (WITHOUT angle brackets < >). If your password has special characters like @ or #, URL-encode them (@ -> %40, # -> %23).
# 3. Notice /upisathi before the ?appName query param - this sets your database name.
DB_URL=mongodb+srv://<db_username>:<db_password>@cluster0.qyv71em.mongodb.net/upisathi?retryWrites=true&w=majority&appName=Cluster0

# Strong random secret key for signed session cookies (min 32 characters)
SESSION_SECRET=c8f39b6e1a4d2f8e705b4a92e1f3d8a7c5b6e2d1f9a8b7c4d3e2f1a0b9c8d7e6

# Frontend origin allowed to make authenticated cookie requests
FRONTEND_ENDPOINT=https://debanshupati.dev

# Production cookie configuration
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=.debanshupati.dev

# Resend Email Configuration for OTP delivery
RESEND_API_KEY=re_your_resend_api_key_here
OTP_EMAILID=otp@debanshupati.dev

# Google OAuth Client ID
GOOGLE_CLIENT_ID=1040841324823-ldkla6kin9ncko6lhplsutpqhrf93k9a.apps.googleusercontent.com
